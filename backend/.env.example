# Copiá este archivo a `.env` y completá los valores reales.
# Nunca subas `.env` al repositorio (ya está en .gitignore).

# URL de conexión a MongoDB (local o Atlas)
MONGO_URL=mongodb://localhost:27017

# Nombre de la base de datos
DB_NAME=voxel_cup_dev

# Orígenes CORS permitidos (separados por coma). Opcional: por defecto "*".
# CORS_ORIGINS=*
